# Copy this file to .env and fill in your values
# NEVER commit .env to git

PORT=3000

# Allowed origins (comma-separated) — add your domain here
ALLOWED_ORIGINS=https://cubegame.club,https://www.cubegame.club,https://cube-game-fnam.onrender.com,http://localhost:3000

# Admin secret for /stats and /audit endpoints
ADMIN_SECRET=your-strong-secret-here

# PayPal business email that receives shop payments — must match CONFIG.paypalEmail
# in shop.js. Used server-side to verify IPN callbacks weren't spoofed/forwarded,
# and to check the /api/paypal/ipn payment actually went to the right account.
PAYPAL_EMAIL=alferedobook@gmail.com
# In your PayPal account: Profile > Profile and Settings > My Selling Tools >
# Instant Payment Notifications > enable IPN and set the URL to:
#   https://YOUR_DOMAIN/api/paypal/ipn

# ── Firebase CLIENT config (served to the browser via /config — never in static JS) ──
# Firebase Console > Project Settings > General > Your apps > Config
FIREBASE_API_KEY="AIzaSyC_gTL3m6Snz9bUcTIr1teBWQG9KsG-0ds",
FIREBASE_AUTH_DOMAIN="cube-game-515d7.firebaseapp.com",
FIREBASE_PROJECT_ID="cube-game-515d7",
FIREBASE_APP_ID="1:232796990803:web:d66c07add2373217a545a6",
FIREBASE_STORAGE_BUCKET="cube-game-515d7.appspot.com",
FIREBASE_SENDER_ID="232796990803"

